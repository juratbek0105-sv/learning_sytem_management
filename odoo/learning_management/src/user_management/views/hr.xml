<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_user_hr_list" model="ir.ui.view">
        <field name="name">user.hr.list</field>
        <field name="model">user.hr</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="login"/>
                <field name="phone"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_user_hr_form" model="ir.ui.view">
        <field name="name">user.hr.form</field>
        <field name="model">user.hr</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="login"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Personal Info">
                            <field name="date_of_birth"/>
                            <field name="gender"/>
                            <field name="language_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_user_hr" model="ir.actions.act_window">
        <field name="name">HRs</field>
        <field name="res_model">user.hr</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_user_hr_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_user_hr_form')})
        ]"/>

    </record>
</odoo>
