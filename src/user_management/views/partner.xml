<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_partner_form_worker_info" model="ir.ui.view">
        <field name="name">res.partner.worker.info.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>

        <field name="arch" type="xml">
            <xpath expr="//group[1]/group[1]" position="inside">
                <field name="user_type"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Worker Information"
                      invisible="user_type == 'student'">
                    <group>
                        <field name="date_of_birth"/>
                        <field name="marital_status"/>
                        <field name="experience_year"/>
                        <field name="gender"/>
                    </group>
                    <group>
                        <field name="work_place_ids" widget="many2many_tags"/>
                        <field name="children_count"/>
                    </group>
                </page>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Education info" invisible="user_type != 'student'">
                    <group>
                        <field name="student_number"/>
                    </group>
                    <seperator/>
                    <group string="Teachers">
                        <field name="teacher_ids"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
    </data>
</odoo>