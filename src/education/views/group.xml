<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_group_list" model="ir.ui.view">
        <field name="name">edu.group.list</field>
        <field name="model">edu.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="course_id"/>
                <field name="state"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_group_form" model="ir.ui.view">
        <field name="name">edu.group.form</field>
        <field name="model">edu.group</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_toggle_group"
                            type="object"
                            string="Deactivate"
                            class="btn-primary"
                            icon="fa-toggle-off"
                            invisible="not active"/>

                    <button name="action_toggle_group"
                            type="object"
                            string="Activate"
                            class="btn-secondary"
                            icon="fa-toggle-on"
                            invisible="active"/>
                    <button name="action_create_timetable"
                            string="Create Timetable"
                            type="object"
                            class="btn-primary"
                            icon="fa-calendar"/>

                    <field name="state" widget="statusbar" statusbar_visible="active,frozen,completed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="course_id"/>
                            <field name="teacher_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="student_ids" widget="many2many_tags"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Timetables">
                            <field name="timetable_id" create="0"/>
                        </page>

                        <page string="Lessons">
                            <field name="lesson_ids" context="{
                                    'default_group_id': id,
                                    'default_course_id': course_id,}">
                                <list editable="bottom">
                                    <field name="teacher_id"/>
                                    <field name="date"/>
                                    <field name="duration"/>
                                    <field name="duration_uom"/>
                                    <field name="is_demo"/>
                                </list>
                            </field>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_group" model="ir.actions.act_window">
        <field name="name">Groups</field>
        <field name="res_model">edu.group</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_group_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_group_form')})
        ]"/>
    </record>
</odoo>
