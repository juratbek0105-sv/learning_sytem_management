<odoo>
    <data noupdate="1">

        <!-- Default Payment Sequence -->
        <record id="seq_payment_general" model="ir.sequence">
            <field name="name">General Payment Sequence</field>
            <field name="code">payment.edu.payment</field>
            <field name="prefix">PAY/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Teacher Salary Sequence -->
        <record id="seq_teacher_salary" model="ir.sequence">
            <field name="name">Teacher Salary Sequence</field>
            <field name="code">payment.teacher.salary</field>
            <field name="prefix">T-SAL/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Student Top-up Sequence -->
        <record id="seq_student_topup" model="ir.sequence">
            <field name="name">Student Top-up Sequence</field>
            <field name="code">payment.student.topup</field>
            <field name="prefix">TOPUP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
