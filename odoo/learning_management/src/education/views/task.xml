<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_task_list" model="ir.ui.view">
        <field name="name">edu.task.list</field>
        <field name="model">edu.task</field>
        <field name="arch" type="xml">
            <list decoration-info="state=='assigned'" decoration-success="state=='reviewed'"
                  decoration-muted="state=='closed'">
                <field name="name"/>
                <field name="course_id"/>
                <field name="group_id"/>
                <field name="deadline"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_task_form" model="ir.ui.view">
        <field name="name">edu.task.form</field>
        <field name="model">edu.task</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <button name="action_assign" type="object"
                                string="Assign" class="btn-primary"
                                icon="fa-send"
                                attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button name="action_close" type="object"
                                string="Close Task" class="btn-secondary"
                                icon="fa-lock"
                                attrs="{'invisible': [('state', 'in', ('closed', 'draft'))]}"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,assigned,submitted,reviewed,closed"/>
                    </header>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="deadline"/>
                            <field name="course_id"/>
                            <field name="group_id"/>
                            <field name="lesson_id"/>
                        </group>
                        <group>
                            <field name="student_ids" widget="many2many_tags"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Enter task details..."/>
                        </page>
                        <page string="Submissions">
                            <field name="submission_ids">
                                <tree string="Submissions">
                                    <field name="student_id"/>
                                    <field name="submit_date"/>
                                    <field name="mark"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_task" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">edu.task</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_task_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_task_form')})
        ]"/>
    </record>
</odoo>
