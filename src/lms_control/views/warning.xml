<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_warning_list" model="ir.ui.view">
        <field name="name">control.warning.list</field>
        <field name="model">control.warning</field>
        <field name="arch" type="xml">
            <list decoration-warning="status=='draft'" decoration-success="status=='reviewed'"
                  decoration-danger="status=='cancelled'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="reason"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_warning_form" model="ir.ui.view">
        <field name="name">control.warning.form</field>
        <field name="model">control.warning</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <button name="action_review" string="Mark as Reviewed" type="object" class="btn-primary"
                                attrs="{'invisible': [('status', '!=', 'draft')]}"/>
                        <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"
                                attrs="{'invisible': [('status', '=', 'cancelled')]}"/>
                        <field name="status" widget="statusbar" statusbar_visible="draft,reviewed,cancelled"/>
                    </header>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>

                    <group>
                        <field name="reason" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_warning" model="ir.actions.act_window">
        <field name="name">Warnings</field>
        <field name="res_model">control.warning</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_warning_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_warning_form')})
        ]"/>
    </record>
</odoo>
