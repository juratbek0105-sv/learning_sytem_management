<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_task_submission_list" model="ir.ui.view">
        <field name="name">edu.task.submission.list</field>
        <field name="model">edu.task.submission</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'reviewed'" decoration-danger="state == 'returned'">
                <field name="task_id"/>
                <field name="student_id"/>
                <field name="submit_date"/>
                <field name="mark"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_task_submission_form" model="ir.ui.view">
        <field name="name">edu.task.submission.form</field>
        <field name="model">edu.task.submission</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <button name="action_review" type="object"
                                string="Mark as Reviewed"
                                class="btn-success"
                                icon="fa-check"
                                attrs="{'invisible': [('state', '=', 'reviewed')]}"/>
                        <button name="action_return" type="object"
                                string="Return"
                                class="btn-secondary"
                                icon="fa-undo"
                                attrs="{'invisible': [('state', '=', 'returned')]}"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="submitted,reviewed,returned"/>
                    </header>

                    <group>
                        <group>
                            <field name="task_id"/>
                            <field name="student_id"/>
                            <field name="submit_date"/>
                        </group>
                        <group>
                            <field name="mark"/>
                            <field name="file_name"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Attachment">
                            <field name="attachment" filename="file_name"/>
                        </page>
                        <page string="Comment">
                            <field name="note" placeholder="Student's comment or explanation..."/>
                        </page>
                        <page string="Teacher Feedback">
                            <field name="feedback" placeholder="Teacher’s feedback or remarks..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_task_submission" model="ir.actions.act_window">
        <field name="name">Task submissions</field>
        <field name="res_model">edu.task.submission</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_task_submission_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_task_submission_form')})
        ]"/>
    </record>
</odoo>
