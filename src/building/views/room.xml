<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_room_list" model="ir.ui.view">
        <field name="name">building.room.list</field>
        <field name="model">building.room</field>
        <field name="arch" type="xml">
            <list>
                <field name="number"/>
                <field name="active"/>
                <field name="capacity"/>
                <field name="floor_id"/>
                <field name="building_id"/>
                <field name="is_under_repair"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_room_form" model="ir.ui.view">
        <field name="name">building.room.form</field>
        <field name="model">building.room</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <button name="action_toggle_room" string="Activate" type="object" class="btn-primary"/>
                        <button name="action_toggle_room" string="Deactivate" type="object" class="btn-secondary"/>
                    </header>
                    <group>
                        <group>
                            <field name="number"/>
                            <field name="active"/>
                            <field name="capacity"/>
                            <field name="is_under_repair"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="building_id"/>
                            <field name="floor_id"/>
                            <field name="room_type"/>
                            <field name="status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">building.room</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_room_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_room_form')})
        ]"/>
    </record>
</odoo>
