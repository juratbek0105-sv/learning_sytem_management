<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_penalty_list" model="ir.ui.view">
        <field name="name">control.penalty.list</field>
        <field name="model">control.penalty</field>
        <field name="arch" type="xml">
            <list decoration-success="status=='paid'" decoration-danger="status=='cancelled'">
                <field name="name"/>
                <field name="user_id"/>
                <field name="amount"/>
                <field name="reason"/>
                <field name="date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_penalty_form" model="ir.ui.view">
        <field name="name">control.penalty.form</field>
        <field name="model">control.penalty</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <header>
                        <button name="action_paid" string="Mark as Paid" type="object" class="btn-primary"
                                modifiers="{'invisible': [('status','!=','draft')]}"/>
                        <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"
                                modifiers="{'invisible': [('status','=','cancelled')]}"/>
                        <field name="status" widget="statusbar" statusbar_visible="draft,paid,cancelled"/>
                    </header>

                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="user_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group>
                        <field name="reason" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_penalty" model="ir.actions.act_window">
        <field name="name">Penalties</field>
        <field name="res_model">control.penalty</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_penalty_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_penalty_form')})
        ]"/>
    </record>
</odoo>
