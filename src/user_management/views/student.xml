<odoo>
    <data>
        <record id="student_list" model="ir.ui.view">
            <field name="name">user.student.list</field>
            <field name="model">user.student</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="student_number"/>
                    <field name="email"/>
                    <field name="login"/>
                    <field name="phone"/>
                </list>
            </field>
        </record>

        <record id="student_form" model="ir.ui.view">
            <field name="name">user.student.form</field>
            <field name="model">user.student</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="student_number"/>
                            <field name="email"/>
                            <field name="login"/>
                            <field name="phone"/>
                            <field name="company_id"/>
                        </group>
                        <notebook>
                            <page string="Teachers">
                                <field name="teacher_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="email"/>
                                        <field name="login"/>
                                        <field name="phone"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_student" model="ir.actions.act_window">
            <field name="name">Students</field>
            <field name="res_model">user.student</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('student_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('student_form')})
        ]"/>
        </record>
    </data>
</odoo>
