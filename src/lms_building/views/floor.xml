<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_floor_list" model="ir.ui.view">
        <field name="name">building.floor.list</field>
        <field name="model">building.floor</field>
        <field name="arch" type="xml">
            <list string="Floors" decoration-muted="not active">
                <field name="number" string="Floor Number"/>
                <field name="building_id" string="Building"/>
                <field name="total_rooms" string="Total Rooms"/>
                <field name="active" widget="boolean_toggle" string="Active"/>
            </list>
        </field>
    </record>

    <record id="view_floor_form" model="ir.ui.view">
        <field name="name">building.floor.form</field>
        <field name="model">building.floor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <button name="action_toggle_floor" string="Activate" type="object"
                                invisible="active" class="btn-primary"/>
                        <button name="action_toggle_floor" string="Deactivate" type="object"
                                invisible="not active" class="btn-secondary"/>
                    </header>
                    <group>
                        <field name="number"/>
                        <field name="active"/>
                        <field name="total_rooms"/>
                        <field name="building_id"/>
                    </group>
                    <notebook>
                        <page string="Rooms">
                            <field name="room_ids">
                                <list>
                                    <field name="capacity"/>
                                    <field name="building_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_floor" model="ir.actions.act_window">
        <field name="name">Floors</field>
        <field name="res_model">building.floor</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_floor_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_floor_form')})
        ]"/>
    </record>
</odoo>
