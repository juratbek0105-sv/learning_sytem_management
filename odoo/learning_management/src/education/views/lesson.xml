<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_lesson_list" model="ir.ui.view">
        <field name="name">edu.lesson.list</field>
        <field name="model">edu.lesson</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="duration"/>
                <field name="course_id"/>
                <field name="group_id"/>
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <field name="is_demo"/>
            </list>
        </field>
    </record>

    <record id="view_lesson_form" model="ir.ui.view">
        <field name="name">edu.lesson.form</field>
        <field name="model">edu.lesson</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="duration"/>
                            <field name="is_demo"/>
                        </group>
                        <group>
                            <field name="course_id"/>
                            <field name="group_id"/>
                            <field name="subject_id"/>
                            <field name="teacher_id"/>
                        </group>
                    </group>


                    <notebook>
                        <page string="Description">
                            <field name="description" nolabel="1"/>
                        </page>
                        <page string="Tasks">
                            <field name="task_ids" context="{'default_lesson_id': active_id}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lesson" model="ir.actions.act_window">
        <field name="name">Lessons</field>
        <field name="res_model">edu.lesson</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_lesson_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_lesson_form')})
        ]"/>
    </record>
</odoo>
