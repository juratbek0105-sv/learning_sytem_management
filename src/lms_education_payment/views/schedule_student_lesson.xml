<odoo>
    <record id="view_schedule_student_lesson_form_inherit" model="ir.ui.view">
        <field name="name">schedule.student.lesson.form.inherit</field>
        <field name="model">edu.schedule.student.lesson</field>
        <field name="inherit_id" ref="lms_education.schedule_student_lesson_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <group>
                    <field name="price" widget="monetary"/>
                    <field name="payment_id"/>
                </group>
            </xpath>

        </field>
    </record>

    <record id="view_schedule_student_lesson_list_inherit" model="ir.ui.view">
        <field name="name">schedule.student.lesson.list.inherit</field>
        <field name="model">edu.schedule.student.lesson</field>
        <field name="inherit_id" ref="lms_education.schedule_student_lesson_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='student_id']" position="after">
                <field name="price" widget="monetary"/>
                <field name="payment_id"/>
            </xpath>
        </field>
    </record>


</odoo>
