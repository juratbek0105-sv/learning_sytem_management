<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ====================== LESSON FORM VIEW ====================== -->
    <record id="view_edu_lesson_form" model="ir.ui.view">
        <field name="name">edu.lesson.form</field>
        <field name="model">edu.lesson</field>
        <field name="arch" type="xml">
            <form string="Lesson">
                <header>
                    <button name="action_change_lesson_date" string="Change Lesson Date" type="object"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="course_id"/>
                        <field name="group_id"/>
                        <field name="teacher_id"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="duration"/>
                        <field name="duration_uom"/>
                    </group>
                    <notebook>
                        <page string="Tasks">
                            <field name="task_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="deadline"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ====================== LESSON LIST VIEW ====================== -->
    <record id="view_edu_lesson_list" model="ir.ui.view">
        <field name="name">edu.lesson.list</field>
        <field name="model">edu.lesson</field>
        <field name="arch" type="xml">
            <list string="Lessons">
                <field name="name"/>
                <field name="sequence"/>
                <field name="course_id"/>
                <field name="group_id"/>
                <field name="teacher_id"/>
                <field name="date"/>
                <field name="duration"/>
                <field name="duration_uom"/>
            </list>
        </field>
    </record>

    <!-- ====================== LESSON ACTION ====================== -->
    <record id="action_lesson" model="ir.actions.act_window">
        <field name="name">Lessons</field>
        <field name="res_model">edu.lesson</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode':'list','view_id':ref('view_edu_lesson_list')}),
            (0, 0, {'view_mode':'form','view_id':ref('view_edu_lesson_form')})
        ]"/>
    </record>
</odoo>
