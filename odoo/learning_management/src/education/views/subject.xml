<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_subject_list" model="ir.ui.view">
        <field name="name">edu.subject.list</field>
        <field name="model">edu.subject</field>
        <field name="arch" type="xml">
            <list decoration-success="active" decoration-danger="not active">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_subject_form" model="ir.ui.view">
        <field name="name">edu.subject.form</field>
        <field name="model">edu.subject</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <button name="action_toggle_subject" type="object"
                                string="Activate" class="btn-primary"
                                icon="fa-check" invisible="active"/>
                        <button name="action_toggle_subject" type="object"
                                string="Deactivate" class="btn-secondary"
                                icon="fa-ban" invisible="not active"/>
                        <field name="active" widget="statusbar" statusbar_visible="active"/>
                    </header>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="teacher_ids" widget="many2many_tags"/>
                            <field name="course_ids" widget="many2many_tags"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Enter subject description..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">edu.subject</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_subject_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_subject_form')})
        ]"/>
    </record>
</odoo>
