<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_edu_payment_list" model="ir.ui.view">
        <field name="name">payment.edu.payment.list</field>
        <field name="model">payment.edu.payment</field>
        <field name="arch" type="xml">
            <list string="Education Payments">
                <field name="user_id"/>
                <field name="amount"/>
                <field name="payment_date"/>
                <field name="status"/>
                <field name="payment_type"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_edu_payment_form" model="ir.ui.view">
        <field name="name">payment.edu.payment.form</field>
        <field name="model">payment.edu.payment</field>
        <field name="arch" type="xml">
            <form string="Education Payment">
                <header>
                    <button name="action_paid"
                            string="Pay"
                            type="object"
                            class="oe_highlight"
                            invisible="status != 'draft'"/>

                    <button name="action_cancelled"
                            string="Cancel"
                            type="object"
                            invisible="status not in ['draft', 'paid']"/>

                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="status == 'draft'"/>

                    <field name="status" widget="statusbar" statusbar_visible="draft,paid,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="amount"/>
                            <field name="detailed_type"/>
                            <field name="student_id" invisible="detailed_type != 'top_up_balance'"/>
                        </group>
                        <group>
                            <field name="payment_date"/>
                            <field name="payment_type"/>
                            <field name="note" colspan="2"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_edu_payment_search" model="ir.ui.view">
        <field name="name">payment.edu.payment.search</field>
        <field name="model">payment.edu.payment</field>
        <field name="arch" type="xml">
            <search string="Search Payments">
                <field name="user_id"/>
                <filter string="Paid" name="paid" domain="[('status','=','paid')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('status','=','cancelled')]"/>
                <filter string="Refunded" name="refunded" domain="[('status','=','refunded')]"/>
            </search>
        </field>
    </record>

    <record id="action_edu_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">payment.edu.payment</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_edu_payment_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_edu_payment_form')})
        ]"/>
    </record>
</odoo>
