<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ====================== SCHEDULE TABLE FORM VIEW ====================== -->
    <record id="view_edu_schedule_table_form" model="ir.ui.view">
        <field name="name">edu.schedule.table.form</field>
        <field name="model">edu.schedule.table</field>
        <field name="arch" type="xml">
            <form string="Timetable">
                <header>
                    <button name="action_activate" string="Activate"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_done" string="Mark as Done"
                            type="object" class="oe_highlight"
                            invisible="state != 'active'"/>

                    <button name="action_cancel" string="Cancel"
                            type="object" class="btn-danger"
                            invisible="state == 'cancel'"/>

                    <button name="action_view_schedule_lessons"
                            string="View Lessons"
                            type="object" icon="fa-calendar"
                            class="oe_stat_button"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,done,cancel"
                           statusbar_colors="{'draft':'muted','active':'blue','done':'green','cancel':'red'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="lesson_start_time" widget="float_time"/>
                            <field name="lesson_end_time" widget="float_time"/>
                            <field name="weekday_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <field name="teacher_id"/>

                        </group>
                        <group>
                            <field name="group_id"/>
                            <field name="first_lesson_date"/>
                            <field name="last_lesson_date"/>
                            <field name="end_date"/>
                            <field name="total_duration"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scheduled Lessons">
                            <field name="schedule_lesson_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="lesson_start_time" widget="float_time"/>
                                    <field name="lesson_end_time" widget="float_time"/>
                                    <field name="sequence"/>
                                    <field name="group_id"/>
                                    <field name="teacher_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_edu_schedule_table_list" model="ir.ui.view">
        <field name="name">edu.schedule.table.list</field>
        <field name="model">edu.schedule.table</field>
        <field name="arch" type="xml">
            <list string="Schedule Tables">
                <field name="name"/>
                <field name="group_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="lesson_start_time"/>
                <field name="lesson_end_time"/>
                <field name="state"/>
                <field name="total_duration"/>
            </list>
        </field>
    </record>

    <record id="action_schedule_table" model="ir.actions.act_window">
        <field name="name">Schedule Tables</field>
        <field name="res_model">edu.schedule.table</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
             (5, 0, 0),
            (0, 0, {'view_mode':'list','view_id':ref('view_edu_schedule_table_list')}),
            (0, 0, {'view_mode':'form','view_id':ref('view_edu_schedule_table_form')})
        ]"/>
    </record>
</odoo>
