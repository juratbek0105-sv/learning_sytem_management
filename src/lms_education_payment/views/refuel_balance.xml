<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="refuel_balance_form" model="ir.ui.view">
            <field name="name">payment.refuel.balance.form</field>
            <field name="model">payment.refuel.balance</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="student_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="refuel_balance_list" model="ir.ui.view">
            <field name="name">payment.refuel.balance.list</field>
            <field name="model">payment.refuel.balance</field>
            <field name="arch" type="xml">
                <list>
                    <field name="student_id"/>
                    <field name="amount"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        <record id="action_refuel_balance" model="ir.actions.act_window">
            <field name="name">Refuel Balance</field>
            <field name="res_model">payment.refuel.balance</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('refuel_balance_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('refuel_balance_form')})
        ]"/>
        </record>
    </data>
</odoo>