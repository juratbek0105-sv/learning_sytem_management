<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="schedule_student_lesson_list" model="ir.ui.view">
            <field name="name">edu.schedule.student.lesson.list</field>
            <field name="model">edu.schedule.student.lesson</field>
            <field name="arch" type="xml">
                <list>
                    <field name="schedule_lesson_id"/>
                    <field name="student_id"/>
                    <field name="price" widget="monetary"/>
                </list>
            </field>
        </record>
        <record id="schedule_student_lesson_form" model="ir.ui.view">
            <field name="name">edu.schedule.student.lesson.form</field>
            <field name="model">edu.schedule.student.lesson</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="schedule_lesson_id"/>
                        <field name="student_id"/>
                        <field name="price" widget="monetary"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_schedule_student_lesson" model="ir.actions.act_window">
            <field name="name">Schedule Student Lessons</field>
            <field name="res_model">edu.schedule.student.lesson</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('schedule_student_lesson_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('schedule_student_lesson_form')})
        ]"/>
        </record>
    </data>
</odoo>