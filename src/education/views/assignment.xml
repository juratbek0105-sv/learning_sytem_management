<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_assignment_list" model="ir.ui.view">
        <field name="name">edu.assignment.list</field>
        <field name="model">edu.assignment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="course_id"/>
                <field name="group_id"/>
                <field name="teacher_id"/>
                <field name="exam_type"/>
                <field name="exam_date"/>
                <field name="deadline"/>
                <field name="max_score"/>
                <field name="pass_score"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_assignment_form" model="ir.ui.view">
        <field name="name">edu.assignment.form</field>
        <field name="model">edu.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_close" type="object" string="Close" class="btn-primary"/>
                    <button name="action_reopen" type="object" string="Reopen"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned,submitted,graded,closed"/>
                </header>

                <sheet>
                    <h1>
                        <field name="name" class="oe_inline" placeholder="Enter assignment title..."/>
                    </h1>

                    <group>
                        <group string="General Information">
                            <field name="description" placeholder="Write assignment instructions here..."/>
                            <field name="upload_file" filename="filename" widget="binary"/>
                        </group>

                        <group string="Exam Details">
                            <field name="exam_type"/>
                            <field name="exam_date"/>
                            <field name="duration"/>
                            <field name="duration_uom"/>
                            <field name="deadline"/>
                            <field name="max_score"/>
                            <field name="pass_score"/>
                        </group>
                    </group>

                    <separator string="Assignment Context" colspan="2"/>

                    <group>
                        <group>
                            <field name="course_id"/>
                            <field name="group_id" context="{'default_course_id': course_id}"
                                   domain="[('course_id','=',course_id)]"
                                   on_change="1"/>
                            <field name="teacher_id"/>
                        </group>
                        <group string="Assigned Students">
                            <field name="student_ids" widget="many2many_tags"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Results">
                            <field name="result_ids">
                                <list editable="bottom">
                                    <field name="student_id"/>
                                    <field name="score"/>
                                    <field name="passed"/>
                                </list>
                            </field>
                        </page>

                        <page string="Description and Notes">
                            <field name="description" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_assignment" model="ir.actions.act_window">
        <field name="name">Assignments</field>
        <field name="res_model">edu.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_assignment_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_assignment_form')})
        ]"/>
    </record>
</odoo>
