<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="student_form_inherit_lms_payment" model="ir.ui.view">
        <field name="name">user.student.form.inherit</field>
        <field name="model">user.student</field>
        <field name="inherit_id" ref="user_management.student_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="before">
                <group string="Payment Info">
                    <field name="total_paid" readonly="1" widget="monetary"/>
                </group>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Payments">
                    <field name="payment_ids" context="{'default_user_id': id}">
                        <list editable="bottom">
                            <field name="payment_date"/>
                            <field name="amount" widget="monetary"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
