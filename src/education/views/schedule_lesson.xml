<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ====================== SCHEDULE LESSON FORM VIEW ====================== -->
    <record id="view_edu_schedule_lesson_form" model="ir.ui.view">
        <field name="name">edu.schedule.lesson.form</field>
        <field name="model">edu.schedule.lesson</field>
        <field name="arch" type="xml">
            <form string="Scheduled Lesson">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,done"
                           statusbar_colors="{'draft':'muted','done':'green'}"/>
                    <button name="action_mark_done" string="Mark Done" type="object"
                            class="btn-success" invisible="state == 'done'"/>
                    <button name="action_reset_draft" string="Reset Draft" type="object"
                            class="btn-warning" invisible="state == 'draft'"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="sequence" readonly="1"/>
                        <field name="schedule_table_id"/>
                        <field name="group_id"/>
                        <field name="teacher_id"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="lesson_start_time"/>
                        <field name="lesson_end_time"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_edu_schedule_lesson_list" model="ir.ui.view">
        <field name="name">edu.schedule.lesson.list</field>
        <field name="model">edu.schedule.lesson</field>
        <field name="arch" type="xml">
            <list string="Scheduled Lessons">
                <field name="name"/>
                <field name="sequence"/>
                <field name="schedule_table_id"/>
                <field name="group_id"/>
                <field name="teacher_id"/>
                <field name="date"/>
                <field name="lesson_start_time"/>
                <field name="lesson_end_time"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_schedule_lesson" model="ir.actions.act_window">
        <field name="name">Scheduled Lessons</field>
        <field name="res_model">edu.schedule.lesson</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
                         (5, 0, 0),
                         (0, 0, {'view_mode':'list','view_id':ref('view_edu_schedule_lesson_list')}),
                         (0, 0, {'view_mode':'form','view_id':ref('view_edu_schedule_lesson_form')})
        ]"/>
    </record>
</odoo>
