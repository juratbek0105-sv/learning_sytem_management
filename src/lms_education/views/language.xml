<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edu_language_list" model="ir.ui.view">
        <field name="name">edu.language.list</field>
        <field name="model">edu.language</field>
        <field name="arch" type="xml">
            <list string="Languages">
                <field name="name"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_edu_language_form" model="ir.ui.view">
        <field name="name">edu.language.form</field>
        <field name="model">edu.language</field>
        <field name="arch" type="xml">
            <form string="Language">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_edu_language" model="ir.actions.act_window">
        <field name="name">Languages</field>
        <field name="res_model">edu.language</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>
