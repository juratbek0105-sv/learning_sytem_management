<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_user_teacher_list" model="ir.ui.view">
        <field name="name">user.teacher.list</field>
        <field name="model">user.teacher</field>
        <field name="arch" type="xml">
            <list string="Teachers">
                <field name="user_id"/>
                <field name="gender"/>
            </list>
        </field>
    </record>

    <record id="view_user_teacher_form" model="ir.ui.view">
        <field name="name">user.teacher.form</field>
        <field name="model">user.teacher</field>
        <field name="arch" type="xml">
            <form string="Teacher">
                <sheet>
                    <group>
                            <field name="user_id"/>
                            <field name="gender"/>
                            <field name="experience_year"/>
                    </group>

                    <notebook>
                        <page string="Work Places">
                            <field name="work_place_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="worked_years"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_user_teacher" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="res_model">user.teacher</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_user_teacher_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_user_teacher_form')})
        ]"/>
    </record>

</odoo>
