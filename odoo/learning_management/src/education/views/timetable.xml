<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_timetable_list" model="ir.ui.view">
        <field name="name">edu.timetable.list</field>
        <field name="model">edu.timetable</field>
        <field name="arch" type="xml">
            <list decoration-muted="duration == 0">
                <field name="name"/>
                <field name="weekday"/>
                <field name="topic"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="duration"/>
                <field name="group_id"/>
            </list>
        </field>
    </record>

    <record id="view_timetable_form" model="ir.ui.view">
        <field name="name">edu.timetable.form</field>
        <field name="model">edu.timetable</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <field name="weekday" widget="statusbar"
                               statusbar_visible="monday,tuesday,wednesday,thursday,friday,saturday,sunday"/>
                    </header>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="group_id"/>
                            <field name="topic"/>
                        </group>
                        <group>
                            <field name="weekday"/>
                            <field name="start_time"/>
                            <field name="end_time"/>
                            <field name="duration" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Notes" colspan="2"/>
                    <field name="message_ids" widget="mail_thread"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_timetable" model="ir.actions.act_window">
        <field name="name">Timetables</field>
        <field name="res_model">edu.timetable</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_timetable_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_timetable_form')})
        ]"/>
    </record>
</odoo>
