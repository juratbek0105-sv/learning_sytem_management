<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_edu_payment_list" model="ir.ui.view">
        <field name="name">payment.edu.payment.list</field>
        <field name="model">payment.edu.payment</field>
        <field name="arch" type="xml">
            <list string="Education Payments">
                <field name="name"/>
                <field name="user_id"/>
                <field name="amount"/>
                <field name="payment_date"/>
                <field name="status"/>
                <field name="payment_type"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_edu_payment_form" model="ir.ui.view">
        <field name="name">payment.edu.payment.form</field>
        <field name="model">payment.edu.payment</field>
        <field name="arch" type="xml">
            <form string="Education Payment">
                <header>
                    <button name="action_paid"
                            string="Pay"
                            type="object"
                            class="btn-primary"
                            invisible="status != 'draft'"/>

                    <button name="action_cancelled"
                            string="Cancel"
                            type="object"
                            class="btn-secondary"
                            invisible="status not in ['draft','paid']"/>

                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            class="btn-light"
                            invisible="status == 'draft'"/>

                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="draft,paid,cancelled"
                           class="oe_status"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="General Information" col="2">
                            <field name="user_id"/>
                            <field name="payment_date"/>
                            <field name="payment_type"/>
                            <field name="detailed_type"/>
                        </group>
                        <group string="Payment Details" col="2">
                            <field name="amount"/>
                            <field name="student_id"
                                   invisible="detailed_type != 'top_up_balance'"/>
                            <field name="teacher_id"
                                   invisible="detailed_type != 'teacher_salary'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_edu_payment_search" model="ir.ui.view">
        <field name="name">payment.edu.payment.search</field>
        <field name="model">payment.edu.payment</field>
        <field name="arch" type="xml">
            <search string="Search Payments">
                <field name="user_id"/>
                <filter string="Paid" name="paid" domain="[('status','=','paid')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('status','=','cancelled')]"/>
                <filter string="Refunded" name="refunded" domain="[('status','=','refunded')]"/>
            </search>
        </field>
    </record>

    <record id="action_edu_payment_top_up_balance" model="ir.actions.act_window">
        <field name="name">Top up Balance</field>
        <field name="res_model">payment.edu.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('detailed_type', '=', 'top_up_balance')]</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_edu_payment_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_edu_payment_form')})
        ]"/>
    </record>
</odoo>
