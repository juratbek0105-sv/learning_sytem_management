<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_user_student_inherit_groups_courses" model="ir.ui.view">
            <field name="name">user.student.inherit.groups.courses</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_simple_form"/>
            <field name="arch" type="xml">

                <xpath expr="//sheet" position="inside">
                    <notebook>
                        <page string="Education Info" invisible="user_type != 'student'">
                            <group>
                                <field name="group_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="state"/>
                                        <field name="course_id"/>
                                    </list>
                                </field>
                                <field name="course_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="total_lessons"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>

    </data>
</odoo>