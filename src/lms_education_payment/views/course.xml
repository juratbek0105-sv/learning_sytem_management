<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_edu_course_form_inherit" model="ir.ui.view">
            <field name="name">edu.course.form.inherit</field>
            <field name="model">edu.course</field>
            <field name="inherit_id" ref="lms_education.view_course_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                     <div class="oe_button_box" name="button_box">
                        <button type="object"
                                name="action_view_payments"
                                class="oe_stat_button"
                                icon="fa-cc-visa">
                            <field name="payment_count" widget="statinfo" string="Payments"/>
                        </button>
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>