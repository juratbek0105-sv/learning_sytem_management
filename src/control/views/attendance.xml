<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_attendance_list" model="ir.ui.view">
        <field name="name">control.attendance.list</field>
        <field name="model">control.attendance</field>
        <field name="arch" type="xml">
            <list decoration-success="status=='present'" decoration-danger="status=='absent'"
                  decoration-warning="status=='late'">
                <field name="name"/>
                <field name="person_type"/>
                <field name="student_id" invisible="person_type!='student'"/>
                <field name="employee_id" invisible="person_type!='employee'"/>
                <field name="date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_attendance_form" model="ir.ui.view">
        <field name="name">control.attendance.form</field>
        <field name="model">control.attendance</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="person_type"/>
                            <field name="student_id" modifiers="{'invisible': [('person_type','!=','student')]}"/>
                            <field name="employee_id" modifiers="{'invisible': [('person_type','!=','employee')]}"/>
                        </group>
                    </group>

                    <separator string="Status" colspan="2"/>
                    <field name="status" widget="statusbar" statusbar_visible="present,absent,late"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_attendance" model="ir.actions.act_window">
        <field name="name">Attendances</field>
        <field name="res_model">control.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_attendance_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_attendance_form')})
        ]"/>
    </record>
</odoo>
