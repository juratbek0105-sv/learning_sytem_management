<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edu_payment_form_inherit" model="ir.ui.view">
        <field name="name">edu.payment.form.inherit</field>
        <field name="model">payment.edu.payment</field>
        <field name="inherit_id" ref="lms_payment.view_edu_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="course_id"/>
                <field name="group_id"/>
            </xpath>
        </field>
    </record>

    <record id="edu_payment_list_inherit" model="ir.ui.view">
        <field name="name">edu.payment.list.inherit</field>
        <field name="model">payment.edu.payment</field>
        <field name="inherit_id" ref="lms_payment.view_edu_payment_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="course_id"/>
                <field name="group_id" context="{'default_course_id': course_id}"
                       domain="[('course_id','=',course_id)]"/>
            </xpath>
        </field>
    </record>

</odoo>
