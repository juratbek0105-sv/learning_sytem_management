<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_course_list" model="ir.ui.view">
        <field name="name">edu.course.list</field>
        <field name="model">edu.course</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="duration"/>
                <field name="duration_uom"/>
                <field name="price"/>
                <field name="total_lessons"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_course_form" model="ir.ui.view">
        <field name="name">edu.course.form</field>
        <field name="model">edu.course</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_course" type="object"
                            string="Open" invisible="state == 'open'"
                            class="btn-primary" icon="fa-chevron-down"/>

                    <button name="action_close_course" type="object"
                            string="Close" invisible="state == 'closed'"
                            class="btn-primary" icon="fa-chevron-up"/>
                    <button name="action_reset_draft_course" type="object"
                            string="Reset to draft" invisible="state != 'closed'"
                            class="btn-primary" icon="fa-refresh"/>
                    <button name="action_create_group" type="object" string="Create Group"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="total_lessons"/>
                            <field name="duration"/>
                            <field name="duration_uom" required="duration != 0"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="price" widget="monetary"/>
                            <field name="teacher_ids" widget="many2many_tags"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Lessons">
                            <field name="lesson_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="sequence"/>
                                    <field name="duration"/>
                                    <field name="duration_uom"/>
                                    <field name="group_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Default Lessons">
                            <field name="course_lesson_ids">
                                <list create="0">
                                    <field name="name"/>
                                    <field name="sequence"/>
                                    <field name="duration"/>
                                    <field name="duration_uom"/>
                                </list>
                            </field>
                        </page>
                        <page string="Groups">
                            <field name="group_ids">
                                <list editable="bottom">
                                    <field name="state"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">edu.course</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_course_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_course_form')})
        ]"/>
    </record>
</odoo>