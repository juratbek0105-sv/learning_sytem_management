<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_kpi_list" model="ir.ui.view">
        <field name="name">payment.kpi.list</field>
        <field name="model">payment.kpi</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="month"/>
                <field name="year"/>
                <field name="score"/>
                <field name="bonus_amount"/>
            </list>
        </field>
    </record>

    <record id="view_kpi_form" model="ir.ui.view">
        <field name="name">payment.kpi.form</field>
        <field name="model">payment.kpi</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="month"/>
                        <field name="year"/>
                        <field name="score"/>
                        <field name="bonus_amount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_kpi" model="ir.actions.act_window">
        <field name="name">KPIs</field>
        <field name="res_model">payment.kpi</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kpi_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_kpi_form')})
        ]"/>
    </record>
</odoo>
