<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_coupon_list" model="ir.ui.view">
        <field name="name">payment.coupon.list</field>
        <field name="model">payment.coupon</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="discount_percent"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="usage_limit"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_coupon_form" model="ir.ui.view">
        <field name="name">payment.coupon.form</field>
        <field name="model">payment.coupon</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="discount_percent"/>
                        <field name="valid_from"/>
                        <field name="valid_to"/>
                        <field name="usage_limit"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_coupon" model="ir.actions.act_window">
        <field name="name">Costs</field>
        <field name="res_model">payment.coupon</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_coupon_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_coupon_form')})
        ]"/>
    </record>
</odoo>
