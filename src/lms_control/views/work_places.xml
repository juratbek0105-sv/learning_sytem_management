<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_control_work_places_list" model="ir.ui.view">
        <field name="name">control.work.places.list</field>
        <field name="model">control.work.places</field>
        <field name="arch" type="xml">
            <list string="Work Places">
                <field name="user_id"/>
                <field name="name"/>
                <field name="worked_years"/>
            </list>
        </field>
    </record>

    <record id="view_control_work_places_form" model="ir.ui.view">
        <field name="name">control.work.places.form</field>
        <field name="model">control.work.places</field>
        <field name="arch" type="xml">
            <form string="Work Place">
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="name"/>
                        <field name="worked_years"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>



    <record id="action_control_work_places" model="ir.actions.act_window">
        <field name="name">Work Places</field>
        <field name="res_model">control.work.places</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
