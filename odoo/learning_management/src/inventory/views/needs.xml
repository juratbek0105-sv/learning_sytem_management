<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_needs_list" model="ir.ui.view">
        <field name="name">inventory.needs.list</field>
        <field name="model">inventory.needs</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="quantity"/>
                <field name="condition"/>
                <field name="branch_id"/>
                <field name="responsible_id"/>
            </list>
        </field>
    </record>

    <record id="view_needs_form" model="ir.ui.view">
        <field name="name">inventory.needs.form</field>
        <field name="model">inventory.needs</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="quantity"/>
                        <field name="condition"/>
                        <field name="branch_id"/>
                        <field name="responsible_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_needs" model="ir.actions.act_window">
        <field name="name">Needs</field>
        <field name="res_model">inventory.needs</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_needs_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_needs_form')})
        ]"/>
    </record>
</odoo>
