<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_performance_list" model="ir.ui.view">
        <field name="name">edu.performance.list</field>
        <field name="model">edu.performance</field>
        <field name="arch" type="xml">
            <list decoration-success="passed" decoration-danger="not passed">
                <field name="student_id"/>
                <field name="assignment_id"/>
                <field name="score"/>
                <field name="passed"/>
            </list>
        </field>
    </record>

    <record id="view_performance_form" model="ir.ui.view">
        <field name="name">edu.performance.form</field>
        <field name="model">edu.performance</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="assignment_id"/>
                        </group>
                        <group>
                            <field name="score"/>
                            <field name="passed" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_performance" model="ir.actions.act_window">
        <field name="name">Performances</field>
        <field name="res_model">edu.performance</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_performance_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_performance_form')})
        ]"/>
    </record>
</odoo>
