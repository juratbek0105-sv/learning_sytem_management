<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_material_list" model="ir.ui.view">
        <field name="name">inventory.material.list</field>
        <field name="model">inventory.material</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="quantity"/>
                <field name="condition"/>
                <field name="company_id"/>
                <field name="responsible_id"/>
            </list>
        </field>
    </record>

    <record id="view_material_form" model="ir.ui.view">
        <field name="name">inventory.material.form</field>
        <field name="model">inventory.material</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <button name="action_material_broken" type="object"
                                string="Mark as broken" class="btn-primary"/>
                        <button name="action_material_expire" type="object"
                                string="Expired"
                                class="btn-primary"/>
                    </header>
                    <group>
                        <field name="name"/>
                        <field name="quantity"/>
                        <field name="condition"/>
                        <field name="company_id"/>
                        <field name="responsible_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_material" model="ir.actions.act_window">
        <field name="name">Materials</field>
        <field name="res_model">inventory.material</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_material_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_material_form')})
        ]"/>
    </record>
</odoo>
