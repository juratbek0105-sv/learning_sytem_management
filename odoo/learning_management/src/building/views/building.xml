<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_building_list" model="ir.ui.view">
        <field name="name">building.building.list</field>
        <field name="model">building.building</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="address"/>
                <field name="active"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_building_form" model="ir.ui.view">
        <field name="name">building.building.form</field>
        <field name="model">building.building</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <button name="action_toggle_building" string="Activate" type="object" class="btn-primary"/>
                        <button name="action_toggle_building" string="Deactivate" type="object" class="btn-secondary"/>
                    </header>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="address"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="manager_id"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rooms">
                            <field name="room_ids">
                                <list>
                                    <field name="capacity"/>
                                    <field name="building_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Floors">
                            <field name="floor_ids">
                                <list>
                                    <field name="number"/>
                                    <field name="total_rooms"/>
                                    <field name="building_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_building" model="ir.actions.act_window">
        <field name="name">Buildings</field>
        <field name="res_model">building.building</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_building_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_building_form')})
        ]"/>
    </record>
</odoo>
