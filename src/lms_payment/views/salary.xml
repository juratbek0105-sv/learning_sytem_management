<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_salary_list" model="ir.ui.view">
        <field name="name">payment.salary.list</field>
        <field name="model">payment.salary</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="month"/>
                <field name="year"/>
                <field name="total_salary"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_salary_form" model="ir.ui.view">
        <field name="name">payment.salary.form</field>
        <field name="model">payment.salary</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="month"/>
                        <field name="year"/>
                        <field name="base_salary"/>
                        <field name="bonus"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_salary" model="ir.actions.act_window">
        <field name="name">Salaries</field>
        <field name="res_model">payment.salary</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_salary_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_salary_form')})
        ]"/>
    </record>
</odoo>
