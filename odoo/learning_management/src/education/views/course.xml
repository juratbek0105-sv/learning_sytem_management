<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_course_list" model="ir.ui.view">
        <field name="name">edu.course.list</field>
        <field name="model">edu.course</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="duration"/>
                <field name="price"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_course_form" model="ir.ui.view">
        <field name="name">edu.course.form</field>
        <field name="model">edu.course</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <button name="action_toggle_course" type="object"
                                string="Activate" invisible="active"
                                class="btn-primary" icon="fa-refresh"/>

                        <button name="action_toggle_course" type="object"
                                string="Deactivate" invisible="not active"
                                class="btn-primary" icon="fa-refresh"/>
                    </header>

                <group>
                    <group>
                        <field name="name"/>
                        <field name="duration"/>
                        <field name="price"/>
                    </group>
                    <group>
                        <field name="teacher_ids" widget="many2many_tags"/>
                        <field name="subject_ids" widget="many2many_tags"/>
                    </group>
                </group>

                <notebook>
                    <page string="Description">
                        <field name="description" nolabel="1"/>
                    </page>

                    <page string="Groups">
                        <field name="group_ids"/>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>

<record id="action_course" model="ir.actions.act_window">
<field name="name">Courses</field>
<field name="res_model">edu.course</field>
<field name="view_mode">list,form</field>
<field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_course_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_course_form')})
        ]"/>
</record>
        </odoo>
