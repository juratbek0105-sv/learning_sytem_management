<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ir_cron_auto_withdraw" model="ir.cron">
        <field name="name">Auto Withdrawal Balance</field>
        <field name="model_id" ref="model_payment_withdrawal_balance"/>
        <field name="state">code</field>
        <field name="code">model.cron_auto_withdraw()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
