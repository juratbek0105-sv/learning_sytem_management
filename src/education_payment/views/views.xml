<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edu_payment_form_inherit" model="ir.ui.view">
        <field name="name">edu.payment.form.inherit</field>
        <field name="model">payment.edu.payment</field>
        <field name="inherit_id" ref="payment.view_edu_payment_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="group_id"/>
                <field name="course_id"/>
            </xpath>

        </field>
    </record>

    <record id="edu_payment_list_inherit" model="ir.ui.view">
        <field name="name">edu.payment.list.inherit</field>
        <field name="model">payment.edu.payment</field>
        <field name="inherit_id" ref="payment.view_edu_payment_list"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="group_id"/>
                <field name="course_id"/>
            </xpath>

        </field>
    </record>
</odoo>
