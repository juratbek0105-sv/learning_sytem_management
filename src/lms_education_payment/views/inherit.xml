<odoo>
    <record id="view_schedule_student_lesson_form_inherit" model="ir.ui.view">
        <field name="name">schedule.student.lesson.form.inherit</field>
        <field name="model">edu.schedule.student.lesson</field>
        <field name="inherit_id" ref="lms_education.schedule_student_lesson_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <group>
                    <field name="payment_id"/>
                </group>
            </xpath>

        </field>
    </record>

    <record id="view_schedule_student_lesson_list_inherit" model="ir.ui.view">
        <field name="name">schedule.student.lesson.list.inherit</field>
        <field name="model">edu.schedule.student.lesson</field>
        <field name="inherit_id" ref="lms_education.schedule_student_lesson_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='student_id']" position="after">
                <field name="payment_id"/>
            </xpath>
        </field>
    </record>

    <record id="student_form_inherit_education_payment" model="ir.ui.view">
        <field name="name">user.student.form.inherit</field>
        <field name="model">user.student</field>
        <field name="inherit_id" ref="user_management.student_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="oe_button_box" name="button_box">
                    <button name="action_balance"
                            type="object"
                            class="oe_stat_button"
                            icon="fa fa-money"
                            string="Balance">
                        <field name="balance" widget="statinfo"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>


</odoo>
